    {
      "name": "Admin Authentication",
      "item": [
        {
          "name": "Login (Get Token)",
          "request": {
            "method": "POST",
            "header": [
              {"key":"Content-Type","value":"application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"YOUR_PASSWORD_HERE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "auth", "login"]
            }
          },
          "response": [],
          "description": "POST /api/admin/auth/login - Returns bearer token\n\nReplace YOUR_PASSWORD_HERE with actual admin password\n\nExpected response:\n{\n  \"ok\": true,\n  \"token\": \"eyJhbGciOiJIUzI1NiIs...\",\n  \"user\": {\n    \"id\": 1,\n    \"username\": \"admin\",\n    \"email\": \"admin@dcutawala.org\"\n  }\n}"
        },
        {
          "name": "Verify Session (Me)",
          "request": {
            "method": "GET",
            "header": [
              {"key":"Authorization","value":"Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "auth", "me"]
            }
          },
          "response": [],
          "description": "GET /api/admin/auth/me - Verify token works\n\nRequires: Authorization: Bearer <token>\n\nExpected: {\"ok\": true, \"authenticated\": true}"
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {"key":"Authorization","value":"Bearer {{admin_token}}"},
              {"key":"Content-Type","value":"application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "auth", "logout"]
            }
          },
          "response": [],
          "description": "POST /api/admin/auth/logout - Revoke token\n\nRequires: Authorization: Bearer <token>"
        }
      ]
    },
    {
      "name": "Admin - Sermons (CRUD)",
      "item": [
        {
          "name": "List Sermons (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {"key":"Authorization","value":"Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/sermons?page=1&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "sermons"],
              "query": [
                {"key":"page","value":"1"},
                {"key":"limit","value":"50"}
              ]
            }
          },
          "response": [],
          "description": "GET /api/admin/sermons - List all sermons (admin only)\n\nResponse includes categories array\n\nSample item:\n{\n  \"id\": \"uuid\",\n  \"slug\": \"sermon-title-2025-01-15\",\n  \"title\": \"Sermon Title\",\n  \"speaker\": \"Pastor John\",\n  \"date\": \"2025-01-15T10:00:00Z\",\n  \"durationMinutes\": 45,\n  \"thumbnailUrl\": \"https://...\",\n  \"videoUrl\": \"https://youtube.com/...\",\n  \"categoryId\": \"uuid\",\n  \"category\": {\"id\":\"...\",\"name\":\"Sermons\",\"slug\":\"sermons\"}\n}"
        },
        {
          "name": "Create Sermon",
          "request": {
            "method": "POST",
            "header": [
              {"key":"Authorization","value":"Bearer {{admin_token}}"},
              {"key":"Content-Type","value":"application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Grace of God\",\n  \"description\": \"A powerful message about God's grace and mercy.\",\n  \"speaker\": \"Pastor John Doe\",\n  \"date\": \"2025-05-04T10:00:00\",\n  \"durationMinutes\": 45,\n  \"thumbnailUrl\": \"https://example.com/thumb.jpg\",\n  \"videoUrl\": \"https://www.youtube.com/watch?v=VIDEO_ID\",\n  \"categorySlug\": \"sermons\",\n  \"categoryName\": \"Sermons\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/sermons",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "sermons"]
            }
          },
          "response": [],
          "description": "POST /api/admin/sermons - Create new sermon\n\nFields: title (required), date (ISO datetime), speaker, description, durationMinutes, thumbnailUrl, videoUrl, categorySlug, categoryName, slug\n\nCategory will be auto-created if slug doesn't exist.\n\nExpected: {\"ok\":true, \"item\":{\"id\":\"...\",\"slug\":\"...\",\"title\":\"...\"}}"
        },
        {
          "name": "Get Single Sermon",
          "request": {
            "method": "GET",
            "header": [
              {"key":"Authorization","value":"Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/sermons/{{sermon_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "sermons", "{{sermon_id}}"]
            }
          },
          "response": [],
          "description": "GET /api/admin/sermons/:id - Get sermon details\n\nReplace {{sermon_id}} with actual sermon ID or slug"
        },
        {
          "name": "Update Sermon",
          "request": {
            "method": "PUT",
            "header": [
              {"key":"Authorization","value":"Bearer {{admin_token}}"},
              {"key":"Content-Type","value":"application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Sermon Title\",\n  \"speaker\": \"Pastor Jane Doe\",\n  \"description\": \"Updated description...\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/sermons/{{sermon_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "sermons", "{{sermon_id}}"]
            }
          },
          "response": [],
          "description": "PUT /api/admin/sermons/:id - Update sermon\n\nSend only fields to update"
        },
        {
          "name": "Delete Sermon",
          "request": {
            "method": "DELETE",
            "header": [
              {"key":"Authorization","value":"Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/sermons/{{sermon_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "sermons", "{{sermon_id}}"]
            }
          },
          "response": [],
          "description": "DELETE /api/admin/sermons/:id - Delete sermon"
        }
      ]
    },
